  "cards": [
    {
      "dot": "cyan",
      "title": "Explicit budgets",
      "items": [
        "8 graph steps; 4 planning calls; 3 external tool calls; 1 call per external provider.",
        "12 evidence items; 36,000 evidence characters; 45-second research deadline.",
        "1 synthesis call; bounded repair; 6 total model calls. Exhaustion routes to a terminal state."
      ]
    },
    {
      "dot": "rose",
      "title": "Authority model",
      "items": [
        "The model proposes an action; the application verifies tool allow-list, provider budget and deadline.",
        "Credentials, ownership, authentication and quota state never enter the graph.",
        "Retrieved instructions are ignored because evidence content has no control-plane authority."
      ]
    },
    {
      "dot": "emerald",
      "title": "Terminal behaviour",
      "items": [
        "Typed outcomes include complete, evidence-ready, needs-user, insufficient, budget-exhausted and failed-safe.",
        "Ambiguous identity stops for user input; missing evidence does not trigger an unbounded search.",
        "This Agent remains default-off, local-only and without an HTTP route while evaluation is incomplete."
      ]
    }
  ]

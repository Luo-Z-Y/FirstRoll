  "cards": [
    {
      "dot": "cyan",
      "title": "Production truth",
      "items": [
        "The public beta is a fixed, bounded workflow; the LangGraph Agent is not exposed over HTTP.",
        "Azure serves the frontend and API; Supabase remains the identity and durable account-data provider.",
        "The run-result store is process-local and expires, so it is not durable history."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Bearer authentication, ownership and quota reservation happen before model work.",
        "Retrieved pages and reviews are evidence, never instructions.",
        "Provider keys are request-scoped and excluded from graph state, logs and persisted results."
      ]
    },
    {
      "dot": "emerald",
      "title": "Local capability",
      "items": [
        "The local edition adds private PDFs, SQLite FTS5 and multilingual dense retrieval.",
        "The Agent is bounded by typed state, explicit tool policy, deadlines and terminal states.",
        "Experimental Agent results must beat the fixed workflow in evaluation before promotion."
      ]
    }
  ]

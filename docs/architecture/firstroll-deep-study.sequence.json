  "cards": [
    {
      "dot": "rose",
      "title": "Safe failure points",
      "items": [
        "Invalid identity, missing film, unavailable quota, provider failure and invalid study each terminate with sanitised public errors.",
        "Disconnected streams mark the transient run failed; they do not leak partial model output.",
        "A result can be read only by the account owner and disappears after the process-local TTL."
      ]
    },
    {
      "dot": "cyan",
      "title": "Deterministic versus probabilistic",
      "items": [
        "Authentication, ownership, quota, evidence budgets, schema validation, citation validation and quality thresholds are application code.",
        "DeepSeek synthesis and repair are probabilistic model calls.",
        "The application—not the model—decides whether a model result may be rendered."
      ]
    },
    {
      "dot": "emerald",
      "title": "Credential handling",
      "items": [
        "A visitor may provide a DeepSeek key for one browser session.",
        "The key travels in a dedicated header and is never placed in graph state, logs or stored output.",
        "Without a personal key, the hosted platform key is used only when the deployment enables it."
      ]
    }
  ]
}

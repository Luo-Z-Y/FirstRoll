  "cards": [
    {
      "dot": "rose",
      "title": "Evidence is data, not authority",
      "items": [
        "Reviews, abstracts, captions and retrieved passages cannot authorise tools or alter application policy.",
        "Provider records are identity-checked, attributed and normalised before packet assembly.",
        "Personal provider keys are deliberately absent from this data flow because they are request-scoped secrets."
      ]
    },
    {
      "dot": "cyan",
      "title": "Bounded context",
      "items": [
        "Ranking, deduplication and character budgets limit what reaches the model.",
        "The public beta uses curated public context; private PDFs and hybrid retrieval remain local-only.",
        "Packet diagnostics expose counts and gaps without exposing confidential content to a planner."
      ]
    },
    {
      "dot": "emerald",
      "title": "Validated delivery",
      "items": [
        "The model produces a structured draft, not render-ready authority.",
        "Schema, citation and quality gates either accept, repair within budget or fail safely.",
        "Hosted results are transient; durable study history is a future architecture change."
      ]
    }
  ]
}

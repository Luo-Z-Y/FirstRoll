{
  "name": "firstroll-web",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:local": "node tools/frontend-build.cjs --local",
    "test:web": "node --test tests/web/*.test.cjs",
    "build": "sh tools/build_web.sh",
    "build:auth": "npm run typecheck && esbuild app/web/auth.ts --bundle --minify --format=iife --outfile=dist/assets/auth.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}

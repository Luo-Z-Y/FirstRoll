# Optional LLM and criticism connectors. Film identity search uses key-free Wikidata.
# Douban MCP is unofficial and is not required for FirstRoll to run.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
FIRSTROLL_EMBEDDINGS=1
FIRSTROLL_PREWARM_EMBEDDINGS=1
FIRSTROLL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Default-off local paired-evaluation adapter; this never enables a hosted HTTP Agent route.
FIRSTROLL_LOCAL_AGENT_ENABLED=0
DOUBAN_COOKIE=
LETTERBOXD_CLIENT_ID=
LETTERBOXD_CLIENT_SECRET=
YOUTUBE_API_KEY=
NYT_API_KEY=
GUARDIAN_API_KEY=

# Optional override for the local write-only settings file.
FIRSTROLL_SETTINGS_PATH=

# Hosted public-beta authentication and paid-feature switch. Keep the switch off until the
# Supabase quota migration is installed and the backend-only DeepSeek key is configured.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
FIRSTROLL_DEEP_STUDY_ENABLED=0

# Optional private study-library folder or JSON manifest of document paths.
FIRSTROLL_LIBRARY_PATH=
FIRSTROLL_LIBRARY_MANIFEST=
FIRSTROLL_LIBRARY_INDEX=

# Optional path to a built moria97/douban-mcp stdio server.
FIRSTROLL_DOUBAN_MCP_PATH=

# Optional word-cloud font. The previous PYCINEMETRICS_WORDCLOUD_FONT name remains
# supported for backwards compatibility with the original project.
FIRSTROLL_WORDCLOUD_FONT=
